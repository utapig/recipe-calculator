# Neon pooled connection string (for app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon direct connection string (for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Frontend API base URL for deployed environments (optional in local)
# Example: https://your-api.example.com
VITE_API_BASE_URL=""

# API server CORS allowed origins (comma-separated)
# Example: https://your-frontend.example.com
CORS_ORIGIN=""
